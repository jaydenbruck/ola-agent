OPENROUTER_API_KEY=sk-or-...
OLA_MODEL=x-ai/grok-4.5
OLA_TOKEN=change-me
# where it listens; on the estate: OLA_BIND=127.0.0.1:8790 OLA_ROOT_PATH=/agent
OLA_BIND=0.0.0.0:8787
OLA_ROOT_PATH=
# data (defaults: server/memory/facts.json, server/attachments)
OLA_FACTS=
OLA_ATTACHMENTS_DIR=
# browser (n2): OLA_PROFILE_DIR overrides server/.profile; OLA_HEADED=1 shows Chromium (debug)
OLA_PROFILE_DIR=

# Optional: path to a JSON file of session cookies (Playwright add_cookies shape) seeded into the browser
# profile at startup, so a site the founder cannot sign into inside the phone takeover (LinkedIn's clipped
# image-captcha) is already logged in. Operator-placed, gitignored, never committed.
# Keep the file under server/.profile/ or outside the repository.
OLA_SEED_COOKIES=
