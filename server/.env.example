OPENROUTER_API_KEY=sk-or-...
OLA_MODEL=x-ai/grok-4.5
OLA_TOKEN=change-me
# where it listens; on the estate: OLA_BIND=127.0.0.1:8790 OLA_ROOT_PATH=/agent
OLA_BIND=0.0.0.0:8787
OLA_ROOT_PATH=
# data (defaults: server/memory/facts.json, server/attachments)
OLA_FACTS=
OLA_ATTACHMENTS_DIR=
# browser (n2): OLA_PROFILE_DIR overrides server/.profile; OLA_HEADED=1 shows Chromium (debug)
OLA_PROFILE_DIR=

# Optionally seed browser session cookies from a JSON file in Playwright add_cookies shape.
# Operator-placed; keep under server/.profile/ or outside the repository, never committed.
# OLA_SEED_COOKIES=
