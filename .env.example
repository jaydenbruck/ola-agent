# Copy this file to server/.env. Never commit live values.

# OpenRouter API key used for model requests. Required for real-model runs.
OPENROUTER_API_KEY=
# OpenRouter model identifier. Override to choose another supported model.
OLA_MODEL=x-ai/grok-4.5
# Shared bearer token. Generate a random value and enter the same value in the app.
OLA_TOKEN=
# Listening host and port for python -m ola.main.
OLA_BIND=0.0.0.0:8787
# Public path prefix supplied by a reverse proxy; blank for direct access.
OLA_ROOT_PATH=
# Optional facts file override; blank uses server/memory/facts.json.
OLA_FACTS=
# Optional upload directory override; blank uses server/attachments/.
OLA_ATTACHMENTS_DIR=

# Optionally seed browser session cookies from a JSON file in Playwright add_cookies shape.
# Operator-placed; keep under server/.profile/ or outside the repository, never committed.
# OLA_SEED_COOKIES=
# voice: OpenAI text-to-speech for POST /speak (unset = the app uses the system voice)
OPENAI_API_KEY=
OLA_TTS_VOICE=nova
